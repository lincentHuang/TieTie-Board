{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "regions": ["hnd1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "git": {
    "deploymentEnabled": { "**": false, "main": true }
  }
}
