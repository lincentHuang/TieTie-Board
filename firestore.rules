rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember(gid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function isOwner(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 狀態、標籤可以沒有（舊資料），有的話格式要對
    function validOrganize(d) {
      return (!('status' in d) || d.status in ['none', 'todo', 'doing', 'done'])
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 5));
    }

    // 便利貼附的照片、輪播開關可以沒有（舊資料），有的話照片最多 5 張（整份文件還有 Firestore 的 1MB 上限把關）
    function validPhotos(d) {
      return (!('photos' in d) || (d.photos is list && d.photos.size() <= 5))
        && (!('carousel' in d) || d.carousel is bool);
    }

    // 頭像可以沒有（匿名成員、舊資料），有的話只能是 LINE / Google 的大頭貼網址（會顯示在每個人的畫面上）
    function validAvatar(d) {
      return !('avatarUrl' in d)
        || (d.avatarUrl is string && d.avatarUrl.size() <= 300
          && d.avatarUrl.matches('https://(profile[.]line-scdn[.]net|lh3[.]googleusercontent[.]com)/[^ ]+'));
    }

    // 成員資料：頭像、推播代碼（快速通報用）可以沒有，有的話格式要對
    function validMember(d) {
      return d.name is string
        && validAvatar(d)
        && (!('pushToken' in d) || (d.pushToken is string && d.pushToken.size() <= 200))
        && (!('pushOS' in d) || d.pushOS in ['ios', 'android']);
    }

    // LINE 帳號 → 成員 uid 的對照表：只有伺服器（/api/line-login，用管理者權限）能讀寫
    match /lineAccounts/{lineUserId} {
      allow read, write: if false;
    }

    // 帳號上記的公布欄清單（換手機、換電腦登入同一個帳號也找得回來）：只有自己能讀寫。
    // 只是索引，寫了別人的邀請碼也讀不到那個公布欄（還是看 members）
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groupIds', 'pendingIds', 'updatedAt'])
        && request.resource.data.groupIds is list && request.resource.data.groupIds.size() <= 100
        && request.resource.data.pendingIds is list && request.resource.data.pendingIds.size() <= 100
        && request.resource.data.updatedAt == request.time;
    }

    match /groups/{gid} {
      // 邀請碼就是鑰匙：知道碼才讀得到群組，不開放列出所有群組
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && gid.size() == 6
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        // 自己的那份隨時讀得到：等房主同意時，靠它知道自己加入了沒
        allow read: if signedIn() && (isMember(gid) || request.auth.uid == uid);
        // 只有房主能把人加進來（建立群組時加自己、同意加入申請）；
        // LINE 群組成員點邀請連結直接加入，是伺服器（/api/join）確認過後用管理者權限寫的
        allow create: if signedIn() && isOwner(gid) && validMember(request.resource.data);
        // 已經是成員：只能改自己的名字、頭像、推播代碼
        allow update: if signedIn() && request.auth.uid == uid && validMember(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // 加入申請：不是從綁定的 LINE 群組點進來的人，要等房主同意。
      // 申請的人只能用自己的名義送、可以收回；房主看得到全部、同意（建立成員資料）或拒絕（刪掉申請）
      match /joinRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(gid));
        allow create, update: if signedIn() && request.auth.uid == uid && !isMember(gid)
          && request.resource.data.keys().hasOnly(['name', 'avatarUrl', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && validAvatar(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(gid));
      }

      // 綁定的 LINE 群組（房主把邀請連結貼到有官方帳號的群組時，/api/line-webhook 記下來）：只有伺服器能讀寫
      match /lineGroups/{lineGroupId} {
        allow read, write: if false;
      }

      // 快速通報：成員都能發（只能用自己的名義、時間由伺服器決定），發的人可以收回
      match /alerts/{alertId} {
        allow read: if signedIn() && isMember(gid);

        allow create: if signedIn() && isMember(gid)
          && request.resource.data.keys().hasOnly(['emoji', 'text', 'level', 'authorId', 'authorName', 'createdAt', 'ackBy'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 30
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 40
          && request.resource.data.level in ['normal', 'urgent']
          && request.resource.data.createdAt == request.time
          && request.resource.data.ackBy == {};

        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

        // 其他成員：只能在 ackBy 裡加上「自己收到了」
        allow update: if signedIn() && isMember(gid) && onlyChanges(['ackBy'])
          && request.resource.data.ackBy.diff(resource.data.ackBy).affectedKeys().hasOnly([request.auth.uid]);
      }

      match /items/{itemId} {
        allow read: if signedIn() && isMember(gid);

        allow create: if signedIn() && isMember(gid)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type in ['note', 'image', 'sticker']
          && request.resource.data.priority in ['none', 'important', 'urgent']
          && request.resource.data.ackBy == {}
          && validOrganize(request.resource.data)
          && validPhotos(request.resource.data);

        // 作者：可以改內容、刪除
        allow update: if signedIn() && resource.data.authorId == request.auth.uid
          && validOrganize(request.resource.data)
          && validPhotos(request.resource.data);
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

        // 其他成員：可以移動 / 調整大小 / 調整圖層（像 Figma 共同編輯），也可以改狀態、標籤
        allow update: if signedIn() && isMember(gid)
          && onlyChanges(['x', 'y', 'w', 'h', 'z', 'status', 'tags'])
          && validOrganize(request.resource.data);

        // 其他成員：只能在 ackBy 裡加上「自己已確認」
        allow update: if signedIn() && isMember(gid) && onlyChanges(['ackBy'])
          && request.resource.data.ackBy.diff(resource.data.ackBy).affectedKeys().hasOnly([request.auth.uid]);
      }
    }
  }
}
