{
  "expo": {
    "name": "貼貼公布欄",
    "slug": "tietie-board",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tietieboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.huanglingcheng.tietieboard",
      "supportsTablet": true
    },
    "android": {
      "package": "com.huanglingcheng.tietieboard",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tietie-board.vercel.app",
              "pathPrefix": "/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.huanglingcheng.tietieboard",
          "widgets": [
            {
              "name": "BoardWidget",
              "displayName": "貼貼公布欄",
              "description": "切換瀏覽每個公布欄的公告、活動，家人發快速通報時馬上變色提醒",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "systemExtraLarge",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BoardWidget",
              "label": "貼貼公布欄",
              "description": "切換瀏覽每個公布欄的公告、活動，家人發快速通報時馬上變色提醒",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "讓你可以把照片貼到公布欄上"
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.huanglingcheng.tietieboard.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.huanglingcheng.tietieboard"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dc8f4c7b-ab68-44fd-8b0d-c4a2b14b4fa9"
      }
    },
    "owner": "lincenthuang"
  }
}
