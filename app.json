{
  "expo": {
    "name": "貼貼公布欄",
    "slug": "tietie-board",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tietieboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.huanglingcheng.tietieboard",
      "supportsTablet": true
    },
    "android": {
      "package": "com.huanglingcheng.tietieboard",
      "adaptiveIcon": {
        "backgroundColor": "#3CC49A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tietie-board.vercel.app",
              "pathPrefix": "/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3CC49A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.huanglingcheng.tietieboard",
          "widgets": [
            {
              "name": "BoardWidget",
              "displayName": "貼貼公布欄",
              "description": "列出每個公布欄還沒確認的公告，左右翻頁看更多；家人發快速通報時馬上變色提醒",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "systemExtraLarge",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "configuration": {
                  "title": "選公布欄",
                  "description": "選這個小工具要看哪個公布欄；順序跟 App 裡「我的公布欄」清單一樣",
                  "parameters": {
                    "board": {
                      "title": "公布欄",
                      "type": "enum",
                      "values": [
                        {
                          "name": "全部公布欄（用 ‹ › 切換）",
                          "value": "all"
                        },
                        {
                          "name": "第 1 個公布欄",
                          "value": "b1"
                        },
                        {
                          "name": "第 2 個公布欄",
                          "value": "b2"
                        },
                        {
                          "name": "第 3 個公布欄",
                          "value": "b3"
                        },
                        {
                          "name": "第 4 個公布欄",
                          "value": "b4"
                        },
                        {
                          "name": "第 5 個公布欄",
                          "value": "b5"
                        },
                        {
                          "name": "第 6 個公布欄",
                          "value": "b6"
                        },
                        {
                          "name": "第 7 個公布欄",
                          "value": "b7"
                        },
                        {
                          "name": "第 8 個公布欄",
                          "value": "b8"
                        }
                      ],
                      "default": "all"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BoardWidget",
              "label": "貼貼公布欄",
              "description": "列出每個公布欄還沒確認的公告，左右翻頁看更多；家人發快速通報時馬上變色提醒",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "讓你可以把照片貼到公布欄上"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3CC49A",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.huanglingcheng.tietieboard.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.huanglingcheng.tietieboard"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dc8f4c7b-ab68-44fd-8b0d-c4a2b14b4fa9"
      }
    },
    "owner": "lincenthuang",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/dc8f4c7b-ab68-44fd-8b0d-c4a2b14b4fa9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
