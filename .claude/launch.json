{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "web-8082",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-bulletin",
        "EXPO_PUBLIC_FIREBASE_API_KEY": "demo-key",
        "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "127.0.0.1"
      },
      "port": 8082
    },
    {
      "name": "web-8083",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-bulletin",
        "EXPO_PUBLIC_FIREBASE_API_KEY": "demo-key",
        "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "127.0.0.1"
      },
      "port": 8083
    },
    {
      "name": "web-8084",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8084"
      ],
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-bulletin",
        "EXPO_PUBLIC_FIREBASE_API_KEY": "demo-key",
        "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "127.0.0.1"
      },
      "port": 8084
    }
  ]
}
